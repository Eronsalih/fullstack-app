# Reference only. You do NOT create this by hand:
# the CI/CD pipeline generates ~/app/.env on the Azure VM from GitHub secrets.
# Use it only if you ever run docker-compose.prod.yml manually on the VM.

IMAGE_PREFIX=ghcr.io/<github-user-lowercase>/<repo-name>
IMAGE_TAG=latest
MONGO_USER=admin
MONGO_PASSWORD=use-letters-and-numbers-only-and-make-it-long
MONGO_DB=appdb
